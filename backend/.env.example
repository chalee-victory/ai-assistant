# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Firebase 서비스 계정 키 JSON 문자열
# 실제 키 파일은 프로젝트 밖 C:\keys\ 에 보관하고,
# 아래처럼 JSON 내용 전체를 한 줄 문자열로 붙여넣거나
# FIREBASE_KEY_PATH 로 파일 경로를 지정한다.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# FIREBASE_KEY_PATH=C:/keys/firebase-serviceAccount.json   # 로컬 개발 시 선택 사용

# CORS 허용 출처 (쉼표로 구분, 배포 시 Vercel URL로 교체)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
